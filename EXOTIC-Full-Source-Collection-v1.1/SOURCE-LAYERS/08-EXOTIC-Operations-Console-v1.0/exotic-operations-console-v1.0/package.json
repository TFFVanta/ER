{
  "name": "exotic-operations-console",
  "version": "1.0.0",
  "private": true,
  "description": "EXOTIC Operations Console for Continuous Operations Runtime v1.0",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "browser": "node scripts/serve.mjs",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "package:win": "electron-builder --win nsis portable",
    "verify": "node scripts/verify-build.mjs",
    "demo:live": "node scripts/mock-runtime.mjs"
  },
  "dependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "center.mingo.exotic.operations",
    "productName": "EXOTIC Operations Console",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/er-logo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EXOTIC Operations Console"
    }
  }
}
