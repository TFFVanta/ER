<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>EXOTIC</title>
<HTA:APPLICATION
  ID="EXOTIC"
  APPLICATIONNAME="EXOTIC"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="EXOTIC.ico"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
/>
<style>
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;background:#f4f4ef;color:#111}
button,input{font:inherit}.app{height:100%;display:grid;grid-template-columns:230px 1fr;grid-template-rows:76px 1fr}
.top{grid-column:1/3;background:#fff;border-bottom:3px solid #111;display:flex;align-items:center;justify-content:space-between;padding:0 22px}
.brand{display:flex;align-items:center;gap:12px}.logo{width:46px;height:46px;object-fit:contain;border:2px solid #111;border-radius:10px}
.brandText b{display:block;font-size:20px;letter-spacing:2px}.brandText span{font-size:10px;font-weight:800;letter-spacing:4px}
.search{width:45%;height:42px;border:2px solid #111;border-radius:11px;background:#f7f7f4;display:flex;align-items:center;padding:0 13px;color:#666}
.search input{width:100%;border:0;outline:0;background:transparent;margin-left:8px}
.user{display:flex;align-items:center;gap:10px}.bell,.avatar{width:42px;height:42px;border:2px solid #111;border-radius:11px;background:#fff;display:grid;place-items:center;font-weight:900}.avatar{border-radius:50%;background:#f4ef73}
.side{background:#fff;border-right:3px solid #111;padding:18px 14px;display:flex;flex-direction:column;justify-content:space-between}
.nav button{width:100%;padding:11px 12px;margin-bottom:7px;border:2px solid transparent;border-radius:10px;background:#fff;text-align:left;font-weight:800;cursor:pointer}
.nav button:hover{background:#f4f4ef}.nav button.active{border-color:#111;background:#f4add2;box-shadow:3px 3px 0 #111}
.health{border-top:2px solid #111;padding-top:14px;font-size:12px;font-weight:800}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#62cf83;border:2px solid #111;margin-right:7px}
.main{overflow:auto;padding:28px}.hero{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:22px}.eyebrow{font-size:10px;letter-spacing:2px;font-weight:900;color:#666;margin:0 0 7px}
h1{font-size:52px;letter-spacing:-3px;line-height:1;margin:0 0 8px}.heroSub{font-weight:700;color:#555}.primary{border:3px solid #111;border-radius:12px;background:#f4add2;padding:12px 16px;font-weight:900;box-shadow:4px 4px 0 #111;cursor:pointer}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:14px}.card,.panel{background:#fff;border:3px solid #111;border-radius:14px;box-shadow:3px 3px 0 #111}
.card{padding:16px;position:relative;overflow:hidden}.card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:8px;border-right:2px solid #111}.pink:before{background:#f4add2}.blue:before{background:#9ed8f6}.yellow:before{background:#f4ef73}.green:before{background:#79d792}
.card span{font-weight:800;color:#555}.card b{display:block;font-size:34px;margin:15px 0 5px}.card small{font-weight:700;color:#666}
.grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px}.panel{padding:17px}.panelHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.panelHead h2{margin:0;font-size:21px}
.project{display:flex;align-items:center;gap:12px;border:2px solid #111;border-radius:11px;padding:12px;margin-bottom:9px}.mark{width:12px;height:38px;border:2px solid #111;border-radius:5px}.p1{background:#f4add2}.p2{background:#9ed8f6}.p3{background:#f4ef73}.p4{background:#79d792}
.pinfo{width:190px}.pinfo b,.pinfo span{display:block}.pinfo span{font-size:12px;color:#666;margin-top:3px}.bar{height:10px;border:2px solid #111;border-radius:10px;flex:1;overflow:hidden}.bar i{display:block;height:100%;background:#111}.percent{font-size:12px;font-weight:800}
.agent{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:2px solid #111}.agent:last-child{border-bottom:0}.agentIcon{width:36px;height:36px;border:2px solid #111;border-radius:9px;background:#9ed8f6;display:grid;place-items:center;font-weight:900}.agentInfo{flex:1}.agentInfo b,.agentInfo span{display:block}.agentInfo span{font-size:12px;color:#666;margin-top:3px}.state{font-size:10px;font-weight:900;border:2px solid #111;border-radius:20px;padding:4px 7px;background:#f4ef73}
.graph{height:260px;position:relative;background:#fafaf7;border:2px solid #111;border-radius:11px}.node{position:absolute;border:3px solid #111;border-radius:10px;padding:9px 12px;font-weight:900;background:#fff;box-shadow:3px 3px 0 #111}.core{left:43%;top:42%;background:#f4add2}.n1{left:8%;top:13%;background:#9ed8f6}.n2{right:9%;top:13%;background:#f4ef73}.n3{left:8%;bottom:13%}.n4{right:8%;bottom:13%}
.activity{display:flex;align-items:center;gap:9px;padding:12px 0;border-bottom:2px solid #111}.activity:last-child{border-bottom:0}.activity span{flex:1;font-weight:700}.activity small{color:#777}
.command{position:fixed;right:28px;bottom:24px;border:3px solid #111;background:#111;color:#fff;border-radius:14px;padding:13px 17px;font-weight:900;box-shadow:5px 5px 0 #f4add2;cursor:pointer}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);padding-top:110px}.palette{width:650px;margin:auto;background:#fff;border:3px solid #111;border-radius:16px;box-shadow:8px 8px 0 #111;padding:14px}.cmdInput{border:2px solid #111;border-radius:10px;padding:12px}.cmdInput input{border:0;outline:0;width:95%;font-size:18px}.cmd{padding:13px 6px;border-top:2px solid #111;font-weight:800}.cmd:hover{background:#f4ef73}
@media(max-width:1000px){.metrics{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}
</style>
<script>
function activate(btn){
 var buttons=document.getElementById('nav').getElementsByTagName('button');
 for(var i=0;i<buttons.length;i++)buttons[i].className='';
 btn.className='active';
}
function openCommand(){document.getElementById('overlay').style.display='block';document.getElementById('cmdBox').focus()}
function closeCommand(){document.getElementById('overlay').style.display='none'}
document.onkeydown=function(e){e=e||window.event;if((e.ctrlKey||e.metaKey)&&e.keyCode==75){openCommand();return false}if(e.keyCode==27)closeCommand()}
</script>
</head>
<body>
<div class="app">
<header class="top">
  <div class="brand"><img class="logo" src="er-logo.png"><div class="brandText"><b>EXOTIC</b><span>PORTAL</span></div></div>
  <div class="search">⌕<input placeholder="Search everything or run a command" onclick="openCommand()"></div>
  <div class="user"><div class="bell">●</div><div class="avatar">M</div></div>
</header>

<aside class="side">
  <div class="nav" id="nav">
    <button class="active" onclick="activate(this)">▦ &nbsp; Home</button>
    <button onclick="activate(this)">▣ &nbsp; Projects</button>
    <button onclick="activate(this)">◆ &nbsp; AI Agents</button>
    <button onclick="activate(this)">↻ &nbsp; Workflows</button>
    <button onclick="activate(this)">◉ &nbsp; Activity</button>
    <button onclick="activate(this)">▥ &nbsp; Analytics</button>
    <button onclick="activate(this)">⚗ &nbsp; Research</button>
    <button onclick="activate(this)">✓ &nbsp; Trust</button>
    <button onclick="activate(this)">⚙ &nbsp; Settings</button>
  </div>
  <div class="health"><span class="dot"></span>Platform healthy<br><br><small>EXOTIC PLATFORM 0.4</small></div>
</aside>

<main class="main">
<section class="hero">
  <div><p class="eyebrow">LIVE OPERATING WORKSPACE</p><h1>Good morning, Mingo.</h1><div class="heroSub">Observe. Map. Predict. Align. Act. Measure. Learn.</div></div>
  <button class="primary">＋ New Project</button>
</section>

<section class="metrics">
  <div class="card pink"><span>Active Projects</span><b>14</b><small>+3 this month</small></div>
  <div class="card blue"><span>AI Agents</span><b>9</b><small>4 active now</small></div>
  <div class="card yellow"><span>Momentum</span><b>87%</b><small>+12% this week</small></div>
  <div class="card green"><span>Build Health</span><b>98%</b><small>All systems stable</small></div>
</section>

<section class="grid">
  <div class="panel">
    <div class="panelHead"><div><p class="eyebrow">WORKSPACE</p><h2>Projects</h2></div><b>VIEW ALL →</b></div>
    <div class="project"><div class="mark p1"></div><div class="pinfo"><b>Exotic Portal</b><span>Building</span></div><div class="bar"><i style="width:78%"></i></div><div class="percent">78%</div></div>
    <div class="project"><div class="mark p2"></div><div class="pinfo"><b>Continuity Engine</b><span>Architecture</span></div><div class="bar"><i style="width:52%"></i></div><div class="percent">52%</div></div>
    <div class="project"><div class="mark p3"></div><div class="pinfo"><b>MINGO Advertising OS</b><span>Prototype</span></div><div class="bar"><i style="width:41%"></i></div><div class="percent">41%</div></div>
    <div class="project"><div class="mark p4"></div><div class="pinfo"><b>Universal Memory Graph</b><span>Stable</span></div><div class="bar"><i style="width:88%"></i></div><div class="percent">88%</div></div>
  </div>

  <div class="panel">
    <div class="panelHead"><div><p class="eyebrow">INTELLIGENCE</p><h2>AI Swarm</h2></div><b>◉</b></div>
    <div class="agent"><div class="agentIcon">A</div><div class="agentInfo"><b>Architect</b><span>Structuring Portal runtime</span></div><div class="state">ACTIVE</div></div>
    <div class="agent"><div class="agentIcon">B</div><div class="agentInfo"><b>Builder</b><span>Compiling interface shell</span></div><div class="state">ACTIVE</div></div>
    <div class="agent"><div class="agentIcon">O</div><div class="agentInfo"><b>Observer</b><span>Tracking workspace state</span></div><div class="state">WATCHING</div></div>
    <div class="agent"><div class="agentIcon">T</div><div class="agentInfo"><b>Trust</b><span>Validating security gates</span></div><div class="state">READY</div></div>
  </div>

  <div class="panel">
    <div class="panelHead"><div><p class="eyebrow">RELATIONSHIPS</p><h2>Live Graph</h2></div><b>◎</b></div>
    <div class="graph"><div class="node core">EXOTIC</div><div class="node n1">Projects</div><div class="node n2">AI</div><div class="node n3">Memory</div><div class="node n4">Automation</div></div>
  </div>

  <div class="panel">
    <div class="panelHead"><div><p class="eyebrow">SYSTEM</p><h2>Live Activity</h2></div><b>⚡</b></div>
    <div class="activity"><b>✓</b><span>Builder compiled Portal shell</span><small>Now</small></div>
    <div class="activity"><b>✓</b><span>Trust verified execution gate</span><small>2m</small></div>
    <div class="activity"><b>✓</b><span>Observer synchronized workspace</span><small>4m</small></div>
    <div class="activity"><b>✓</b><span>Architect updated project graph</span><small>9m</small></div>
  </div>
</section>
</main>
<button class="command" onclick="openCommand()">⌘ &nbsp; Portal</button>
</div>

<div id="overlay" class="overlay" onclick="closeCommand()">
 <div class="palette" onclick="window.event.cancelBubble=true">
   <div class="cmdInput">⌘ &nbsp;<input id="cmdBox" placeholder="Build, search, open, deploy..."></div>
   <p class="eyebrow" style="margin-top:16px">SUGGESTED COMMANDS</p>
   <div class="cmd">Build a new app →</div><div class="cmd">Open Exotic Portal project →</div><div class="cmd">Run platform health check →</div><div class="cmd">Create an automation →</div>
 </div>
</div>
</body></html>